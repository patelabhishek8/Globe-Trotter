# Database Configuration (MySQL / SQLite fallback)
# For local SQLite fallback: sqlite:///./globetrotter.db
# For Docker / Production MySQL:
DATABASE_URL=mysql+pymysql://globetrotter_user:globetrotter_pass@localhost:3306/globetrotter

# JWT Security
JWT_SECRET_KEY=globetrotter-super-secure-jwt-secret-key-2026-production

# App Environment
ENVIRONMENT=development
PORT=8000
